# Copy this file to .env and keep the resulting file local.
# Phase 0 reads no secrets and connects to no external service.

AI_HUB_ENV=development
AI_HUB_CONFIG_DIR=config
AI_HUB_WORKSPACE_DIR=workspace
AI_HUB_LOG_LEVEL=INFO

# Reserved for Phase 1. Leave empty until the relevant integration exists.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
OPENAI_API_KEY=
GITHUB_TOKEN=
