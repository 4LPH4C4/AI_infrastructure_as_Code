# Copy this file to .env and keep the resulting file local.
# Values shown here are safe defaults or empty placeholders, never credentials.

AI_HUB_ENVIRONMENT=development
AI_HUB_REPOSITORY_ROOT=.
AI_HUB_CONFIG_DIR=config
AI_HUB_WORKSPACE_DIR=workspace
AI_HUB_DATABASE_PATH=workspace/tasks/ai-hub.sqlite3
AI_HUB_USE_EXAMPLE_CONFIG=false
AI_HUB_HOST=127.0.0.1
AI_HUB_PORT=8765
AI_HUB_LOG_LEVEL=INFO
AI_HUB_MAX_CONCURRENT_TASKS=2
AI_HUB_POLL_INTERVAL_SECONDS=1
AI_HUB_SHUTDOWN_TIMEOUT_SECONDS=30
AI_HUB_CODEX_EXECUTABLE=codex
AI_HUB_CODEX_TIMEOUT_SECONDS=3600
AI_HUB_RUNTIME_OUTPUT_LIMIT_BYTES=1000000

# Slack remains fail-closed until explicitly enabled with both tokens and an allowlist.
AI_HUB_SLACK_ENABLED=false
AI_HUB_SLACK_ALLOWED_USER_IDS=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
